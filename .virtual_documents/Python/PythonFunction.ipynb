# fabonacci series
def fib(n):
    a=0
    b=1
    print(a)
    print(b)

    for i in range(0,n):
        c=a+b
        a=b
        b=c
        print(c)

fib(3)        


# fabonacci series
def fib(n):
    a,b=0,1
    if n<=1:
        print(a)
    else:
        print(a)
        print (b)

    for i in range(2,n):
        c=a+b
        a=b
        b=c
        print(c)

fib(10)
    


# Factorial

def fact(n):
    f=1
    for i in range(1,n+1):
        f=f*i
    return f


fact(5)


